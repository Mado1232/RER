@echo off
chcp 65001 >nul
title Развертывание макета квитка на сервере

echo ==========================================================
echo        Развертывание проекта на сервере 167.172.108.199
echo ==========================================================
echo.
echo 1. Копирование файлов в директорию /var/www/html/ на сервере...
echo    (Если появится запрос "fingerprint" — напишите yes и нажмите Enter)
echo    (Затем введите пароль от вашего сервера и нажмите Enter)
echo.

scp -o StrictHostKeyChecking=accept-new -r index.html styles.css app.js root@167.172.108.199:/var/www/html/

if %ERRORLEVEL% EQU 0 (
    echo.
    echo ==========================================================
    echo [УСПЕХ] Файлы успешно скопированы на сервер!
    echo.
    echo Теперь сайт доступен по адресу:
    echo   http://167.172.108.199/           (Редактор)
    echo   http://167.172.108.199/?view=clean (Чистый вид для смартфона)
    echo ==========================================================
) else (
    echo.
    echo ==========================================================
    echo [ОШИБКА] Не удалось скопировать файлы.
    echo Проверьте правильность пароля или доступность сервера.
    echo ==========================================================
)

echo.
pause
